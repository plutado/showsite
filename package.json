{
  "name": "showsite",
  "version": "0.1.0",
  "description": "A static site generator for podcasts and video series: episode pages, a podcast RSS feed with iTunes and Podcasting 2.0 tags, chapters, transcripts, and a sitemap.",
  "license": "MIT",
  "author": "David Fugate",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutado/showsite.git"
  },
  "homepage": "https://github.com/plutado/showsite#readme",
  "bugs": "https://github.com/plutado/showsite/issues",
  "keywords": [
    "podcast",
    "rss",
    "static-site-generator",
    "podcasting20",
    "video"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "showsite": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "themes"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "demo": "npm run build && node dist/cli.js build examples/demo-show --out _site"
  },
  "dependencies": {
    "eta": "^4.6.0",
    "marked": "^18.1.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-xml-parser": "^5.11.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
